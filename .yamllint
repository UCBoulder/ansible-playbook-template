---
# This file is derived from a template repo, if making global changes, modify here:
# https://github.com/UCBoulder/ansible-playbook-template
#
# Rules section largely taken from
# https://ansible.readthedocs.io/projects/lint/rules/yaml/#yamllint-configuration
# with local modifications.
extends: default

ignore: |
  collections/
  !collections/requirements.yml
  roles/
  !roles/requirements.yml

rules:
  comments:
    # https://github.com/prettier/prettier/issues/6780
    min-spaces-from-content: 1
  # https://github.com/adrienverge/yamllint/issues/384
  indentation: disable
  comments-indentation: false
  document-start: disable
  # 160 chars was the default used by old E204 rule, but
  # you can easily change it or disable in your .yamllint file.
  line-length: false
  # We are adding an extra space inside braces as that's how prettier does it
  # and we are trying not to fight other linters.
  braces:
    min-spaces-inside: 0 # yamllint defaults to 0
    max-spaces-inside: 1 # yamllint defaults to 0
  # key-duplicates:
  #   forbid-duplicated-merge-keys: true # not enabled by default
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  # quoted-strings:
  #   quote-type: double
  #   required: only-when-needed
  trailing-spaces: false
  truthy: false
